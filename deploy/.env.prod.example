# 운영 서버 환경변수. 이 파일을 .env.prod로 복사해서 채운다 (.env.prod는 git에 올리지 않음).

# ---- docker compose ----
DOMAIN=meongnyang.duckdns.org

# ---- Django ----
DEBUG=False
# python3 -c "import secrets; print(secrets.token_urlsafe(50))" 로 만든다
SECRET_KEY=
CI_HASH_SECRET=
ALLOWED_HOSTS=meongnyang.duckdns.org
CSRF_TRUSTED_ORIGINS=https://meongnyang.duckdns.org

# RDS PostgreSQL
DATABASE_URL=postgres://meongnyang:비밀번호@RDS엔드포인트:5432/meongnyang

# S3 (EC2에 IAM 역할을 붙이면 키를 안 넣어도 된다)
AWS_STORAGE_BUCKET_NAME=meongnyang-media
AWS_S3_REGION_NAME=ap-northeast-2

# ---- 지인 베타 ----
# 본인인증·등록번호 조회 계약 전까지 mock으로 운영. 초대 코드를 아는 사람만 가입.
IDENTITY_PROVIDER=mock
PET_REGISTRY_PROVIDER=mock
ALLOW_MOCK_PROVIDERS=True
BETA_INVITE_CODE=

# ---- 기타 ----
PUSH_ENABLED=True
REPORT_HIDE_THRESHOLD=3
GUNICORN_WORKERS=3
