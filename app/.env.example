# 복사해서 .env로 사용. EXPO_PUBLIC_ 값은 앱에 포함되므로 비밀값을 넣지 마세요.
# 안드로이드 에뮬레이터: http://10.0.2.2:8000 / 실기기: http://<PC 사설 IP>:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# 카카오맵 JavaScript 키. 비워 두면 지도 대신 목록만 보인다.
EXPO_PUBLIC_KAKAO_JS_KEY=
# 카카오 콘솔 → 플랫폼 → Web 사이트 도메인에 등록한 주소
EXPO_PUBLIC_KAKAO_MAP_ORIGIN=https://meongnyang.app
