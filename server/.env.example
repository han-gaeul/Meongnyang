# 복사해서 .env로 사용하세요. .env는 git에 올리지 않습니다.
DEBUG=True
SECRET_KEY=local-dev-only-change-me-0123456789abcdefghijklmnop
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# 비우면 로컬 SQLite 사용. 배포: postgres://user:pass@host:5432/dbname
DATABASE_URL=

# CI(본인인증 고유값) 해시용 비밀값
CI_HASH_SECRET=local-dev-only-change-me-0123456789abcdefghijk

# 외부 연동: mock(개발용) | portone / cocon (계약 후 구현)
IDENTITY_PROVIDER=mock
PET_REGISTRY_PROVIDER=mock

# 소셜 로그인 검증용 (앱의 공개 client ID와 같아야 함)
GOOGLE_CLIENT_IDS=

# 업로드 저장소: 비우면 로컬(server/media), 배포 시 S3 버킷 이름
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-northeast-2

# 서로 다른 사람의 신고가 이 수에 도달하면 글·댓글 자동 숨김
REPORT_HIDE_THRESHOLD=3

# Expo 푸시 전송 (운영에서 True)
PUSH_ENABLED=False
